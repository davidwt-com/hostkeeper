# Copy this file to .env and fill in the values below — or just run
# ./install-local.sh, which does this and prompts for anything left empty.

# Host entry in ~/.ssh/config to connect through.
SSH_ALIAS=

# Remote unix user whose mailbox check.sh / check-detailed.sh /
# mark-mail-read.sh read.
MAIL_USER=

# Remote tmux session name connect.sh attaches to (or creates).
TMUX_SESSION=

# Absolute path to the installed wrapper on the remote host. Must match
# WRAPPER_DEST in remote/install-remote.sh if you change it from the default.
REMOTE_MAINT_PATH=

# If a *.local.sh script (see service-status.local.sh.sample) needs its own
# token-authed REST API access — for whatever app you actually run, called
# directly over HTTPS, not through SSH — add its URL/token vars here,
# following this same pattern. Keep the var names generic in this tracked
# file; only your real, gitignored .env should name the actual app/service.
