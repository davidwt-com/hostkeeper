.superpowers/

# Host-specific config — never commit.
.env

# The real wrapper and every copy of it, at any depth: remote/claude-maint,
# a claude-maint.new left behind by an interrupted install, a stale copy at
# the repo root, editor backups. All of them carry real whitelist data, so
# match by name rather than by exact path.
claude-maint*
# ...except the tracked templates, which hold no host specifics and must
# stay committed (remote/claude-maint.sample, claude-maint.sudoers.sample).
!claude-maint*.sample

# Any personal, host/service-specific script (e.g. a detailed status report
# for whatever you actually run, or a local hook check.sh/check-detailed.sh
# source if present) — same reasoning as claude-maint*: real names, real
# endpoints, real tokens. Only the generic *.sample template stays tracked.
*.local.sh
!*.local.sh.sample

# Personal / machine-local Claude Code settings.
.claude/settings.local.json

# Runtime state, not config.
*.sock

# Pre-existing local clutter from before this repo was templated.
archive/
resume

# JetBrains IDE project files
.idea/

# VS Code local project settings
.vscode/
