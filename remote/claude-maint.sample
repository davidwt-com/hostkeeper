#!/usr/bin/env bash
# /usr/local/sbin/claude-maint
#
# Single controlled entry point for the passwordless-sudo maintenance
# workflow. This is the ONLY command that should ever appear in a NOPASSWD
# sudoers line for this purpose.
#
# CRITICAL: never make this a passthrough (no `sudo "$@"`, no `bash -c "$*"`,
# no `eval`). Every action must be an explicit case below with its own
# whitelist. Anything not listed here is refused.
#
# Ownership/perms this file MUST have (install-remote.sh sets these):
#   chown root:root /usr/local/sbin/claude-maint
#   chmod 755 /usr/local/sbin/claude-maint
# If the user calling this can write to this file, the whole design is void.

set -euo pipefail

LOG=/var/log/claude-maint.log
CALLER="$(logname 2>/dev/null || whoami)"

log() {
  echo "$(date -Is) [${CALLER}] $*" >> "$LOG"
}

# Services this script is allowed to touch at all. Add to this list
# deliberately, one at a time, not with a wildcard.
# e.g. ALLOWED_SERVICES=(nginx docker)
ALLOWED_SERVICES=()

# Docker containers this script is allowed to touch. Same rule: add
# deliberately, by exact name, never a wildcard.
# e.g. ALLOWED_CONTAINERS=(web worker)
ALLOWED_CONTAINERS=()

is_allowed_service() {
  local svc="$1"
  for s in "${ALLOWED_SERVICES[@]}"; do
    [[ "$svc" == "$s" ]] && return 0
  done
  return 1
}

is_allowed_container() {
  local c="$1"
  for x in "${ALLOWED_CONTAINERS[@]}"; do
    [[ "$c" == "$x" ]] && return 0
  done
  return 1
}

# Compose projects this script is allowed to touch, mapped to their fixed
# directory (must contain the docker-compose.yml). Only the key is ever
# taken from user input — the path is never user-supplied, so there's no
# way to point this at an arbitrary directory.
# e.g. COMPOSE_PROJECTS=([app]="/srv/app")
declare -A COMPOSE_PROJECTS=()

# Where compose-backup writes archives, and how many to keep per project.
# Root-owned, 0700 — backups contain whatever the stack's volumes hold.
BACKUP_ROOT=/var/backups/hostkeeper
BACKUP_KEEP=5

is_allowed_compose_project() {
  [[ -n "${COMPOSE_PROJECTS[$1]+x}" ]]
}

# For any optional service-name argument passed into docker/compose: must be
# a plain token, and specifically must not start with "-", so it can never
# be interpreted as a flag by docker/docker compose.
is_safe_token() {
  [[ "$1" =~ ^[A-Za-z0-9_.-]+$ ]] && [[ "$1" != -* ]]
}

# Back up one compose project: every named volume its containers use, plus
# the compose/env files sitting in the project directory. Used by both the
# compose-backup action and the backup step inside compose-update. The
# project name is always validated by the caller before this runs.
do_compose_backup() {
  local proj="$1"
  local dir="${COMPOSE_PROJECTS[$proj]}"
  local dest="${BACKUP_ROOT}/${proj}"
  local out="${dest}/$(date +%Y%m%d-%H%M%S).tar.gz"
  local -a vols=() paths=() keep=() old=()
  local v p f a b rc skip

  install -d -o root -g root -m 700 "$dest"

  while IFS= read -r v; do
    [[ -n "$v" ]] && vols+=("$v")
  done < <(
    cd "$dir" && docker compose ps -qa | while read -r cid; do
      [[ -n "$cid" ]] || continue
      docker inspect "$cid" --format \
        '{{range .Mounts}}{{if eq .Type "volume"}}{{.Name}}{{"\n"}}{{end}}{{end}}'
    done | sort -u
  )

  # A stopped stack still has containers, so discovery must include them
  # (compose-update deliberately stops before backing up). Losing this is
  # how a backup silently degrades to config-only.
  if [[ ${#vols[@]} -eq 0 ]]; then
    echo "warning: no named volumes found for '$proj' — archiving config only" >&2
  fi

  for v in "${vols[@]}"; do
    p="$(docker volume inspect "$v" --format '{{.Mountpoint}}' 2>/dev/null || true)"
    [[ -n "$p" && -d "$p" ]] && paths+=("$p")
  done

  # Bind-mounted config the stack depends on but no named volume holds
  # (management.json, turnserver.conf, per-service env files, ...). Only
  # sources under the project directory are taken: a bind mount from
  # outside it (docker.sock, /etc/localtime, ...) is system state, not
  # this project's data, and has no business in a project backup.
  while IFS= read -r p; do
    [[ -n "$p" ]] || continue
    [[ "$p" == "$dir" || "$p" == "$dir"/* ]] || continue
    [[ -e "$p" ]] && paths+=("$p")
  done < <(
    cd "$dir" && docker compose ps -qa | while read -r cid; do
      [[ -n "$cid" ]] || continue
      docker inspect "$cid" --format \
        '{{range .Mounts}}{{if eq .Type "bind"}}{{.Source}}{{"\n"}}{{end}}{{end}}'
    done | sort -u
  )

  # Compose/env files sitting in the project directory. These are usually
  # read by the compose CLI rather than mounted, so the sweep above misses
  # them.
  for f in docker-compose.yml docker-compose.yaml compose.yml compose.yaml setup.env .env; do
    [[ -f "${dir}/${f}" ]] && paths+=("${dir}/${f}")
  done

  if [[ ${#paths[@]} -eq 0 ]]; then
    echo "refused: found nothing to back up for project '$proj'" >&2
    return 1
  fi

  # Drop duplicates, then anything already covered by an ancestor path, so
  # a file mounted by two containers (or a directory and a file inside it)
  # is archived exactly once.
  mapfile -t paths < <(printf '%s\n' "${paths[@]}" | sort -u)
  for a in "${paths[@]}"; do
    skip=0
    for b in "${paths[@]}"; do
      [[ "$a" == "$b" ]] && continue
      [[ "$a" == "$b"/* ]] && { skip=1; break; }
    done
    [[ $skip -eq 0 ]] && keep+=("$a")
  done
  paths=("${keep[@]}")

  echo "archiving ${#paths[@]} path(s) -> ${out}"
  printf '  %s\n' "${paths[@]}"
  # tar strips the leading "/" itself, so restores can't clobber system paths
  # by accident. Exit 1 is "file changed while reading" — tolerable on a live
  # stack; anything higher is a real failure.
  rc=0
  tar -czf "$out" "${paths[@]}" 2>/dev/null || rc=$?
  if [[ $rc -gt 1 ]]; then
    echo "backup failed (tar exit $rc)" >&2
    rm -f "$out"
    return 1
  fi
  chmod 600 "$out"
  ls -lh "$out" | awk '{print "wrote: " $9 " (" $5 ")"}'

  mapfile -t old < <(ls -1t "${dest}"/*.tar.gz 2>/dev/null | tail -n +$((BACKUP_KEEP + 1)))
  if [[ ${#old[@]} -gt 0 ]]; then
    echo "pruning ${#old[@]} backup(s) beyond the newest ${BACKUP_KEEP}"
    rm -f "${old[@]}"
  fi
}

ACTION="${1:-}"
shift || true

case "$ACTION" in

  status)
    svc="${1:-}"
    is_allowed_service "$svc" || { echo "refused: unlisted service '$svc'" >&2; exit 1; }
    log "status $svc"
    systemctl status "$svc" --no-pager
    ;;

  restart)
    svc="${1:-}"
    is_allowed_service "$svc" || { echo "refused: unlisted service '$svc'" >&2; exit 1; }
    log "restart $svc"
    systemctl restart "$svc"
    ;;

  logs)
    svc="${1:-}"
    is_allowed_service "$svc" || { echo "refused: unlisted service '$svc'" >&2; exit 1; }
    lines="${2:-100}"
    [[ "$lines" =~ ^[0-9]+$ ]] || lines=100
    log "logs $svc ($lines lines)"
    journalctl -u "$svc" -n "$lines" --no-pager
    ;;

  disk)
    log "disk"
    df -h
    ;;

  auth-log)
    lines="${1:-20}"
    [[ "$lines" =~ ^[0-9]+$ ]] || lines=20
    log "auth-log ($lines lines)"
    # Auth events (sshd, sudo, su, login, PAM) live in the journal under the
    # authpriv facility (SYSLOG_FACILITY=10) on systems with no auth.log.
    journalctl SYSLOG_FACILITY=10 -n "$lines" --no-pager
    ;;

  docker-ps)
    log "docker-ps"
    docker ps --format 'table {{.Names}}\t{{.Status}}\t{{.Image}}'
    ;;

  docker-logs)
    c="${1:-}"
    is_allowed_container "$c" || { echo "refused: unlisted container '$c'" >&2; exit 1; }
    lines="${2:-100}"
    [[ "$lines" =~ ^[0-9]+$ ]] || lines=100
    log "docker-logs $c ($lines lines)"
    docker logs --tail "$lines" "$c"
    ;;

  docker-restart)
    c="${1:-}"
    is_allowed_container "$c" || { echo "refused: unlisted container '$c'" >&2; exit 1; }
    log "docker-restart $c"
    docker restart "$c"
    ;;

  docker-stats)
    log "docker-stats"
    docker stats --no-stream
    ;;

  apt-upgrade)
    log "apt-upgrade"
    apt-get update
    DEBIAN_FRONTEND=noninteractive apt-get -y upgrade
    ;;

  ufw-status)
    log "ufw-status"
    ufw status verbose
    ;;

  fail2ban-status)
    log "fail2ban-status"
    for jail in $(fail2ban-client status | sed -n 's/.*Jail list:[[:space:]]*//p' | tr ',' ' '); do
      fail2ban-client status "$jail"
    done
    ;;

  apparmor-status)
    log "apparmor-status"
    aa-status
    ;;

  mail-queue)
    log "mail-queue"
    mailq
    ;;

  compose-ps)
    proj="${1:-}"
    is_allowed_compose_project "$proj" || { echo "refused: unlisted compose project '$proj'" >&2; exit 1; }
    log "compose-ps $proj"
    (cd "${COMPOSE_PROJECTS[$proj]}" && docker compose ps)
    ;;

  compose-logs)
    proj="${1:-}"
    is_allowed_compose_project "$proj" || { echo "refused: unlisted compose project '$proj'" >&2; exit 1; }
    svc="${2:-}"
    lines="${3:-100}"
    [[ "$lines" =~ ^[0-9]+$ ]] || lines=100
    if [[ -n "$svc" ]]; then
      is_safe_token "$svc" || { echo "refused: bad service token" >&2; exit 1; }
      log "compose-logs $proj $svc ($lines lines)"
      (cd "${COMPOSE_PROJECTS[$proj]}" && docker compose logs --tail "$lines" "$svc")
    else
      log "compose-logs $proj (all services, $lines lines)"
      (cd "${COMPOSE_PROJECTS[$proj]}" && docker compose logs --tail "$lines")
    fi
    ;;

  compose-restart)
    proj="${1:-}"
    is_allowed_compose_project "$proj" || { echo "refused: unlisted compose project '$proj'" >&2; exit 1; }
    svc="${2:-}"
    if [[ -n "$svc" ]]; then
      is_safe_token "$svc" || { echo "refused: bad service token" >&2; exit 1; }
      log "compose-restart $proj $svc"
      (cd "${COMPOSE_PROJECTS[$proj]}" && docker compose restart "$svc")
    else
      log "compose-restart $proj (whole stack)"
      (cd "${COMPOSE_PROJECTS[$proj]}" && docker compose restart)
    fi
    ;;

  ports)
    log "ports"
    ss -tulnp
    ;;

  docker-disk)
    log "docker-disk"
    docker system df
    echo
    docker system df -v | awk '/^Local Volumes space usage:/{p=1} p'
    ;;

  compose-images)
    proj="${1:-}"
    is_allowed_compose_project "$proj" || { echo "refused: unlisted compose project '$proj'" >&2; exit 1; }
    log "compose-images $proj"
    (
      cd "${COMPOSE_PROJECTS[$proj]}"
      for cid in $(docker compose ps -qa); do
        svc="$(docker inspect "$cid" --format '{{index .Config.Labels "com.docker.compose.service"}}')"
        img="$(docker inspect "$cid" --format '{{.Image}}')"
        tags="$(docker image inspect "$img" --format '{{if .RepoTags}}{{join .RepoTags ", "}}{{else}}<untagged>{{end}}')"
        digest="$(docker image inspect "$img" --format '{{if .RepoDigests}}{{index .RepoDigests 0}}{{else}}<none>{{end}}')"
        built="$(docker image inspect "$img" --format '{{.Created}}')"
        printf 'service : %s\n  tags   : %s\n  digest : %s\n  built  : %s\n\n' \
          "$svc" "$tags" "$digest" "${built%%T*}"
      done
    )
    ;;

  cert-expiry)
    c="${1:-}"
    is_allowed_container "$c" || { echo "refused: unlisted container '$c'" >&2; exit 1; }
    log "cert-expiry $c"
    # Find the ACME store on the host side of this container's mounts. Only
    # domains and expiry dates are ever printed — never the account key or
    # the private key material stored alongside the certificates.
    store=""
    while IFS= read -r src; do
      [[ -n "$src" ]] || continue
      cand=""
      if [[ -f "$src" && "$src" == *.json ]]; then
        cand="$src"
      elif [[ -d "$src" ]]; then
        cand="$(find "$src" -maxdepth 2 -type f -name 'acme*.json' 2>/dev/null | head -1)"
      fi
      if [[ -n "$cand" ]] && jq -e '..|.Certificates? // empty' "$cand" >/dev/null 2>&1; then
        store="$cand"
        break
      fi
    done < <(docker inspect "$c" --format '{{range .Mounts}}{{.Source}}{{"\n"}}{{end}}')

    if [[ -z "$store" ]]; then
      echo "no ACME certificate store found in the mounts for '$c'" >&2
      exit 1
    fi

    echo "store: $store"
    printf '%-45s %s\n' DOMAIN EXPIRES
    jq -r '..|.Certificates? // empty | .[] | "\(.domain.main)\t\(.certificate)"' "$store" |
      while IFS=$'\t' read -r domain cert; do
        [[ -n "$cert" && "$cert" != "null" ]] || continue
        enddate="$(printf '%s' "$cert" | base64 -d 2>/dev/null |
          openssl x509 -noout -enddate 2>/dev/null | cut -d= -f2)"
        printf '%-45s %s\n' "$domain" "${enddate:-<unreadable>}"
      done
    ;;

  compose-backup)
    proj="${1:-}"
    is_allowed_compose_project "$proj" || { echo "refused: unlisted compose project '$proj'" >&2; exit 1; }
    log "compose-backup $proj"
    do_compose_backup "$proj"
    ;;

  compose-update)
    proj="${1:-}"
    is_allowed_compose_project "$proj" || { echo "refused: unlisted compose project '$proj'" >&2; exit 1; }
    # Requires a literal "confirm" so this can never fire by accident.
    if [[ "${2:-}" != "confirm" ]]; then
      echo "refused: compose-update needs the literal argument 'confirm'" >&2
      echo "usage: claude-maint compose-update $proj confirm" >&2
      log "REFUSED compose-update $proj (no confirm)"
      exit 1
    fi
    dir="${COMPOSE_PROJECTS[$proj]}"
    log "compose-update $proj (pull, stop, backup, up -d)"
    echo "==> pulling images"
    (cd "$dir" && docker compose pull)
    echo
    echo "==> stopping stack"
    (cd "$dir" && docker compose stop)
    echo
    echo "==> backing up while stopped (consistent copy)"
    if ! do_compose_backup "$proj"; then
      echo "backup failed — restarting the stack unchanged and aborting" >&2
      (cd "$dir" && docker compose up -d)
      log "compose-update $proj ABORTED (backup failed)"
      exit 1
    fi
    echo
    echo "==> starting stack on the pulled images"
    (cd "$dir" && docker compose up -d)
    echo
    echo "==> current state"
    (cd "$dir" && docker compose ps)
    ;;

  *)
    echo "refused: unknown action '$ACTION'" >&2
    echo "allowed actions: status|restart|logs|disk|ports|auth-log|docker-ps|docker-logs|docker-restart|docker-stats|docker-disk|apt-upgrade|cert-expiry|compose-ps|compose-logs|compose-restart|compose-images|compose-backup|compose-update|ufw-status|fail2ban-status|apparmor-status|mail-queue" >&2
    log "REFUSED unknown action: $ACTION $*"
    exit 1
    ;;
esac
